<body class="home">




<div id="trigger-point">

<header>

<h1 id="logo"><a href="aris.pdf"><img src="images/aris_website.png" alt="お店の名前"></a></h1>

<!--動画＆スライドショー-->
<aside id="mainimg">
<div class="slide slide1"></div>
<div class="slide slide1"><video src="images/balliland.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide2"><video src="images/dust.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide3"><video src="images/osu.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide4"><video src="images/UDK.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide2"></div>
<div class="slide slide5"><video src="images/vita.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide6"><video src="images/sneakers.mp4" autoplay loop muted playsinline></video></div>
<div class="slide slide7"><video src="images/escape.mp4" autoplay loop muted playsinline></video></div>
</aside>

</header>

</div>
<!--/#trigger-point-->



<!--クーポンボタン-->
<div id="message-parts">
        <a href="#" id="playButton"><i class="fa-solid fa-music"></i>Music</a>
    </div>
 <!-- Audio element -->
    <audio id="audioPlayer" src="bg.mp3" preload="auto"></audio>
    
       

<script>
        // Get the button and audio elements
        const playButton = document.getElementById('playButton');
        const audioPlayer = document.getElementById('audioPlayer');

        // Add an event listener to the button
        playButton.addEventListener('click', function() {
            // Play the audio when the button is clicked
            audioPlayer.play();
        });
    </script>
    
    
<!--ページの上部へ戻るボタン-->
<div class="pagetop"><a href="#"><i class="fas fa-angle-double-up"></i></a></div>

<!--開閉ボタン（ハンバーガーアイコン）-->
<div id="menubar_hdr">
<span></span><span></span><span></span>
</div>

